rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Default Deny: Block all access unless explicitly permitted
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Explicit Role Check against Firestore /admins/{uid} document:
    // Requires document to exist AND role to be explicitly 'admin' or 'superadmin'
    function isFirestoreAdmin() {
      return firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
        (firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'admin' ||
         firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'superadmin');
    }

    // Zero-Trust Admin Check for Storage:
    // 1. Primary Owner Email Allowlist: chrisburnsjj@gmail.com
    // 2. Custom Claims: admin == true or role == 'admin'
    // 3. Firestore Document: /admins/{uid} exists with role == 'admin' or 'superadmin'
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'chrisburnsjj@gmail.com' ||
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        isFirestoreAdmin()
      );
    }

    // CMS Media, Showcase Assets & Uploads:
    // - Public read: Allowed so visitors can view images across the live website
    // - Write/Delete: Strictly restricted to verified studio administrators with file size & mime type validation
    match /{folder}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && (request.resource == null || (request.resource.size <= 25 * 1024 * 1024 && request.resource.contentType.matches('image/.*|application/pdf')));
    }
  }
}

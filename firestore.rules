rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny: All paths locked down unless explicitly permitted
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Explicit Role Check on /admins/{uid} Document:
    // Requires document to exist AND role to be explicitly 'admin' or 'superadmin'
    function hasAdminDocRole() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin');
    }

    // Zero-Trust Admin Authorization Gate:
    // Only verified studio administrators can perform write/mutate operations.
    // 1. Primary Owner Allowlist: verified email matching the studio administrator account
    // 2. Custom Claims: Firebase token claim admin == true or role == 'admin'
    // 3. Firestore Document: Authorized admin document in /admins/{uid} with role == 'admin' or 'superadmin'
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'chrisburnsjj@gmail.com' ||
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        hasAdminDocRole()
      );
    }

    // Admins Collection:
    // Strictly restricted to authorized admins. Non-admins cannot read or write admin records.
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Public CMS Content Collections:
    // - Unauthenticated visitors & regular users: READ-ONLY access to render the live public website.
    // - Authenticated regular (non-admin) users: READ-ONLY access. Writes are strictly DENIED.
    // - Authorized administrators: Full CREATE, UPDATE, DELETE permissions.

    // Site Settings (Hero, About, Contact, Navigation, Footer, General)
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Services Collection
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Projects / Portfolio Collection
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Testimonials Collection
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Team Collection
    match /team/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Media Library Collection
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

